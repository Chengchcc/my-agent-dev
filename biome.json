{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/bun.lock",
      "!**/drizzle",
      "!**/dist",
      "!**/src/vendor",
      "!**/public/monaco/**",
      "!**/.next",
      "!skills/loop-workflow/workflow.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": {
        "noLabelWithoutControl": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useButtonType": "off",
        "useSemanticElements": "off",
        "noSvgWithoutTitle": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "off",
        "noTemplateCurlyInString": "off",
        "noNonNullAssertedOptionalChain": "off"
      },
      "correctness": {
        "noUnusedVariables": "off",
        "useYield": "off",
        "noUnsafeOptionalChaining": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/tui/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noControlCharactersInRegex": "off"
          },
          "complexity": {
            "noUselessEmptyExport": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useNodejsImportProtocol": "off"
          }
        }
      }
    }
  ]
}
