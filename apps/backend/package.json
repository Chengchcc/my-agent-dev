{
  "name": "@chengchenccc/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Team Runtime HTTP Server \u2014 L5 Backend",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./app": "./dist/app.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run --cwd ../.. build --filter=@chengchenccc/backend^... && bun run src/main.ts",
    "lint": "biome check . && eslint .",
    "format": "biome check --write .",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:migrate:backend": "bun run src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@chengchenccc/adapter-oma-agent": "workspace:*",
    "@chengchenccc/adapter-mcp": "workspace:*",
    "@chengchenccc/adapter-omp-agent": "workspace:*",
    "@chengchenccc/adapter-pi-agent": "workspace:*",
    "@chengchenccc/adapter-claude-agent": "workspace:*",
    "@chengchenccc/ai": "workspace:*",
    "@chengchenccc/api-contract": "workspace:*",
    "@chengchenccc/config": "workspace:*",
    "@chengchenccc/message": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.0.0",
    "zod": "^3.23.0",
    "@chengchenccc/agent-contract": "workspace:*",
    "@chengchenccc/source-fetch": "workspace:*"
  },
  "devDependencies": {
    "@chengchenccc/test-helpers": "workspace:*"
  }
}
