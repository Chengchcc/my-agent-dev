{
  "version": 1,
  "id": "self-heal",
  "meta": {
    "name": "Issue Self-Heal",
    "description": "Detect -> auto-fix -> human confirm -> forked exits",
    "tags": ["self-heal", "demo", "showcase"],
    "status": "active",
    "owner": "builtin",
    "updatedBy": "oma"
  },
  "input": [
    {
      "key": "issueUrl",
      "type": "string"
    }
  ],
  "triggers": [],
  "nodes": [
    {
      "id": "start",
      "type": "start"
    },
    {
      "id": "detect",
      "type": "script",
      "runtime": "bun",
      "code": "export default async (ctx) => {\n  // Mock detect: route to failure from issueUrl (demo routing)\n  const url = String(ctx.issueUrl ?? \"\");\n  const isBroken = url.includes(\"broken\");\n  return { broken: isBroken, attempts: 1 };\n}",
      "output": [
        {
          "key": "broken",
          "type": "boolean"
        },
        {
          "key": "attempts",
          "type": "number"
        }
      ],
      "timeoutMs": 5000
    },
    {
      "id": "auto-fix",
      "type": "script",
      "runtime": "bun",
      "code": "export default async (ctx) => {\n  // Auto-fix: simple fallback logic\n  return { fixed: true, resolution: \"auto-degraded\" };\n}",
      "output": [
        {
          "key": "fixed",
          "type": "boolean"
        },
        {
          "key": "resolution",
          "type": "string"
        }
      ],
      "timeoutMs": 5000
    },
    {
      "id": "confirm",
      "type": "human",
      "question": "Self-heal plan needs human confirm: accept the auto-fix result?",
      "form": {
        "action": {
          "type": "enum",
          "label": "Action",
          "options": ["accept", "rollback", "manual"],
          "required": true
        },
        "note": {
          "type": "textarea",
          "label": "Note"
        }
      }
    },
    {
      "id": "done",
      "type": "end",
      "status": "success"
    },
    {
      "id": "escalate",
      "type": "end",
      "status": "escalated"
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "detect"
    },
    {
      "from": "detect",
      "to": "auto-fix",
      "when": {
        "==": [
          {
            "var": "detect.output.broken"
          },
          true
        ]
      }
    },
    {
      "from": "detect",
      "to": "confirm",
      "when": {
        "==": [
          {
            "var": "detect.output.broken"
          },
          false
        ]
      }
    },
    {
      "from": "auto-fix",
      "to": "confirm"
    },
    {
      "from": "confirm",
      "to": "done",
      "when": {
        "==": [
          {
            "var": "confirm.output.action"
          },
          "accept"
        ]
      }
    },
    {
      "from": "confirm",
      "to": "escalate",
      "when": {
        "==": [
          {
            "var": "confirm.output.action"
          },
          "manual"
        ]
      }
    }
  ]
}
