{
  "name": "@my-agent-team/coding-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "coding-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "bun src/cli.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "lint": "biome check . && eslint ."
  },
  "dependencies": {
    "@my-agent-team/adapter-mcp": "workspace:*",
    "@my-agent-team/agent": "workspace:*",
    "@my-agent-team/agent-backend": "workspace:*",
    "@my-agent-team/ai": "workspace:*",
    "@my-agent-team/core": "workspace:*",
    "@my-agent-team/config": "workspace:*",
    "@my-agent-team/message": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@my-agent-team/plugin-progressive-skill": "workspace:*",
    "@my-agent-team/plugin-todo": "workspace:*",
    "@my-agent-team/plugin-recap": "workspace:*",
    "@my-agent-team/tools-common": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@my-agent-team/test-helpers": "workspace:*",
    "bun-types": "latest",
    "typescript": "^5.7.0",
    "@my-agent-team/adapter-coding-agent": "workspace:*"
  }
}
